import "@typespec/http";
import "@typespec/openapi";
import "@typespec/openapi3";
import "./common.tsp";
import "./models.tsp";
import "./auth.tsp";
import "./v1.tsp";

using Http;
using OpenAPI;

/**
 * DevCast backend API (Slim Framework 4 / PHP).
 *
 * Generated by hand-reading the live controllers under `backend/src/Futures`
 * and `backend/src/Config/routes.php`, since the backend has no schema
 * library (no zod / class-validator equivalent) to generate from
 * automatically. Treat this spec as the source of truth for the HTTP
 * contract; when the backend changes, update the corresponding `.tsp`
 * file in this directory and recompile with `bun run build`.
 */
@service(#{ title: "DevCast API" })
@info(#{ version: "1.0.0" })
@server("http://localhost:8080", "Local development")
namespace DevCast;

@doc("""
  Catch-all 404 for unmatched routes (backend/src/Futures/Errors/ErrorsController.php:11).
  In the live FastRoute config this is registered as `GET /{path:.*}` and matches any
  path, including ones with slashes; TypeSpec's single path-segment parameter below is a
  reasonable documentation approximation rather than a literal route match.
  """)
@route("/{path}")
@tag("Errors")
interface Errors {
  @get
  notFound(@path path: string): DevCast.Common.ApiNotFoundResponse;
}
