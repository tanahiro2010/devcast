---
const stats = [
	{ value: "3", label: "対応プラットフォーム" },
	{ value: "1", label: "記事のSource of Truth" },
	{ value: "0秒", label: "投稿先を悩む時間" },
];
---

<section class="max-w-5xl mx-auto px-6 py-14 border-b border-hairline">
	<div class="grid grid-cols-3 gap-6 text-center">
		{stats.map((stat) => (
			<div>
				<p class="text-3xl font-semibold tracking-tight">{stat.value}</p>
				<p class="text-sm text-neutral-500 mt-1">{stat.label}</p>
			</div>
		))}
	</div>
</section>
