---
import ThemeToggle from "./ThemeToggle.astro";

const nav = [
	{ label: "Product", href: "/#features" },
	{ label: "Pricing", href: "/pricing" },
	{ label: "API", href: "/#api" },
	{ label: "FAQ", href: "/faq" },
];
---

<header class="sticky top-0 z-50 border-b border-hairline dark:border-white/10 bg-white/80 dark:bg-neutral-950/80 backdrop-blur">
	<div class="max-w-5xl mx-auto px-6 h-16 flex items-center justify-between">
		<a href="/" class="link-lift font-semibold tracking-tight text-[15px] dark:text-white">DevCast</a>
		<nav class="hidden md:flex items-center gap-10 text-[13px] text-neutral-500 dark:text-neutral-400 font-medium">
			{nav.map((item) => (
				<a href={item.href} class="link-lift hover:text-neutral-900 dark:hover:text-white">{item.label}</a>
			))}
		</nav>
		<div class="flex items-center gap-5 text-[13px] font-medium">
			<ThemeToggle />
			<a href="https://app.devcast.work/login" class="link-lift text-neutral-500 dark:text-neutral-400 hover:text-neutral-900 dark:hover:text-white">Sign in</a>
			<a
				href="https://app.devcast.work/signup"
				class="link-lift bg-neutral-900 dark:bg-white text-white dark:text-neutral-900 px-4 py-2 rounded-md hover:bg-neutral-700 dark:hover:bg-neutral-200 transition"
			>
				Get started
			</a>
		</div>
	</div>
</header>
