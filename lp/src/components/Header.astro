---
const nav = [
	{ label: "Product", href: "/#features" },
	{ label: "Pricing", href: "/pricing" },
	{ label: "API", href: "/#api" },
	{ label: "FAQ", href: "/#faq" },
];
---

<header class="sticky top-0 z-50 border-b border-hairline bg-white/80 backdrop-blur">
	<div class="max-w-5xl mx-auto px-6 h-16 flex items-center justify-between">
		<a href="/" class="font-semibold tracking-tight text-[15px]">DevCast</a>
		<nav class="hidden md:flex items-center gap-10 text-[13px] text-neutral-500 font-medium">
			{nav.map((item) => (
				<a href={item.href} class="hover:text-neutral-900">{item.label}</a>
			))}
		</nav>
		<div class="flex items-center gap-5 text-[13px] font-medium">
			<a href="https://app.devcast.work/login" class="text-neutral-500 hover:text-neutral-900">Sign in</a>
			<a
				href="https://app.devcast.work/signup"
				class="bg-neutral-900 text-white px-4 py-2 rounded-md hover:bg-neutral-700 transition"
			>
				Get started
			</a>
		</div>
	</div>
</header>
