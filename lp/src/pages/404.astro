---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<Layout
	path="/404"
	title="ページが見つかりません | DevCast"
	description="お探しのページは見つかりませんでした。"
	noindex={true}
>
	<Header />
	<section class="max-w-3xl mx-auto px-6 py-32 text-center">
		<p class="kicker text-[12px] font-semibold text-accent uppercase mb-4">404</p>
		<h1 class="text-3xl sm:text-4xl font-semibold tracking-tight mb-4">ページが見つかりません</h1>
		<p class="text-neutral-500 text-[15px] mb-10">
			お探しのページは移動または削除された可能性があります。URLをご確認いただくか、トップページからお探しください。
		</p>
		<a
			href="/"
			class="link-lift inline-block bg-neutral-900 text-white text-sm font-medium px-6 py-3 rounded-md hover:bg-neutral-700 transition"
		>
			トップページへ戻る
		</a>
	</section>
	<Footer />
</Layout>
